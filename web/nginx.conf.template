server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Il frontend chiama /api/...: inoltra all'API togliendo il prefisso.
    location /api/ {
        proxy_pass ${API_URL}/;
        proxy_http_version 1.1;
        # Host e SNI dell'API, non del frontend: servono quando l'API sta dietro un altro dominio
        # (Render, App Service), che smista le richieste proprio in base al nome host.
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        # Sui piani gratuiti l'API dorme: al risveglio puo' metterci piu' di 60 secondi.
        proxy_read_timeout 180s;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Routing lato client di Angular.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
